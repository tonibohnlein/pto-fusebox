from __OUTPUT_HEAD_MODULE__ import __OUTPUT_HEAD_FUNCTION__
import pypto.language as pl


@pl.program
class NativeQwenOutputHead:
    # Native orchestration calls one maximal static region. Fusebox owns any
    # fusion or cut decisions inside the complete RMSNorm -> LM-head DAG.
    @pl.function(type=pl.FunctionType.Orchestration)
    def main(
        self,
        hidden_states: pl.Tensor[[16, 512], pl.BF16],
        norm_weight: pl.Tensor[[1, 512], pl.FP32],
        lm_head_weight: pl.Tensor[[192, 512], pl.BF16],
        output: pl.Out[pl.Tensor[[16, 192], pl.FP32]],
    ) -> pl.Tensor[[16, 192], pl.FP32]:
        # A serving program may place the same static call inside its runtime
        # loops; it must not pre-partition the tensor DAG before Fusebox sees it.
        output = __OUTPUT_HEAD_FUNCTION__(__OUTPUT_HEAD_ARGUMENTS__)
        return output
